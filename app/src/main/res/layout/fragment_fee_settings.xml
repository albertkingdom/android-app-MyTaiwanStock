<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.setting.FeeSettingsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="24dp">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/discount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/fee_settings_discount"
            app:errorEnabled="true"
            app:suffixText="@string/fee_settings_discount_unit">

            <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/discount_edit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/whole_lot_minimum_fee"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/fee_settings_whole_lot_minimum"
            app:errorEnabled="true"
            app:suffixText="@string/dollar_unit">

            <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/whole_lot_minimum_fee_edit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/odd_lot_minimum_fee"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/fee_settings_odd_lot_minimum"
            app:errorEnabled="true"
            app:suffixText="@string/dollar_unit">

            <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/odd_lot_minimum_fee_edit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/fee_settings_footer"
            android:textColor="?android:textColorSecondary" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
