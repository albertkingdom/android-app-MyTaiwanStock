<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.MyNewsApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Every Material 3 color role, from the md_theme_* colors (light in values, dark in values-night). -->
        <item name="colorPrimary">@color/md_theme_primary</item>
        <item name="colorOnPrimary">@color/md_theme_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_theme_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_on_primary_container</item>
        <item name="colorSecondary">@color/md_theme_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_on_secondary_container</item>
        <item name="colorTertiary">@color/md_theme_tertiary</item>
        <item name="colorOnTertiary">@color/md_theme_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/md_theme_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/md_theme_on_tertiary_container</item>
        <item name="colorError">@color/md_theme_error</item>
        <item name="colorOnError">@color/md_theme_on_error</item>
        <item name="colorErrorContainer">@color/md_theme_error_container</item>
        <item name="colorOnErrorContainer">@color/md_theme_on_error_container</item>
        <item name="colorSurface">@color/md_theme_surface</item>
        <item name="colorOnSurface">@color/md_theme_on_surface</item>
        <item name="colorSurfaceVariant">@color/md_theme_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_on_surface_variant</item>
        <item name="colorSurfaceContainerLowest">@color/md_theme_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/md_theme_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/md_theme_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/md_theme_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/md_theme_surface_container_highest</item>
        <item name="colorSurfaceBright">@color/md_theme_surface_bright</item>
        <item name="colorSurfaceDim">@color/md_theme_surface_dim</item>
        <item name="colorOutline">@color/md_theme_outline</item>
        <item name="colorOutlineVariant">@color/md_theme_outline_variant</item>
        <item name="colorSurfaceInverse">@color/md_theme_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/md_theme_inverse_on_surface</item>
        <item name="colorPrimaryInverse">@color/md_theme_inverse_primary</item>
        <item name="android:colorBackground">@color/md_theme_background</item>
        <item name="colorOnBackground">@color/md_theme_on_background</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Customize your theme here. -->
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:dialogTheme">@style/CustomDialog</item>
        <item name="android:datePickerDialogTheme">@style/CustomDialog</item>
        <!--    preference page dialog -->
        <item name="alertDialogTheme">@style/MyPreferenceDialogTheme</item>
        <item name="textInputStyle">@style/Widget.App.TextInputLayout</item>
        <!-- Preference page icon       -->
        <item name="preferenceTheme">@style/MyPreference</item>
        <item name="android:tint">@null</item>
    </style>
    <style name="Theme.MyNewsApp.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
    <style name="Theme.MyNewsApp.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />
    <style name="Theme.MyNewsApp.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
    <style name="SearchViewStyle" parent="Widget.AppCompat.SearchView">

        <item name="android:tint">?attr/colorOnSurfaceVariant</item>
    </style>
    <!-- Framework dialogs such as DatePickerDialog; the night version is in values-night -->
    <style name="CustomDialog" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/dialog_accent</item>
    </style>

    <style name="AddFollowingListDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog" />

    <!--    text input border color-->
    <style name="TextInputLayoutStyle" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeWidth">2dp</item>
    </style>
<!--    override material text input field-->
    <style name="Widget.App.TextInputLayout" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.TextInputLayout</item>
    </style>
    <style name="ThemeOverlay.App.TextInputLayout" parent="">
        <item name="colorPrimary">@color/black</item>
        <item name="colorOnSurface">@android:color/transparent</item>
        <item name="editTextStyle">@style/Widget.App.TextInputLayout.Edit</item>
    </style>
    <style name="Widget.App.TextInputLayout.Outlined" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.TextInputLayout.Outlined</item>
    </style>
    <style name="ThemeOverlay.App.TextInputLayout.Outlined" parent="">
        <item name="editTextStyle">@style/Widget.Material3.TextInputEditText.OutlinedBox</item>
    </style>
    <!-- Trade import edit dialog: readable in light and dark mode -->
    <style name="ThemeOverlay.App.TradeEditDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/dialog_action</item>
    </style>
    <style name="Widget.App.TextInputLayout.Outlined.Dialog">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.TextInputLayout.Outlined.Dialog</item>
    </style>
    <style name="ThemeOverlay.App.TextInputLayout.Outlined.Dialog">
        <item name="colorPrimary">@color/dialog_action</item>
    </style>
    <style name="Widget.App.TextInputLayout.Edit" parent="@style/Widget.Material3.TextInputEditText.FilledBox">

    </style>
<!--    -->
<!--    news page-->
    <style name="roundedImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>
<!--    following list-->
    <style name="followingListItem" parent="">
        <item name="android:backgroundTint">@color/recyclerview_background</item>
    </style>
<!--    preference page dialog -->
    <style name="MyPreferenceDialogTheme" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="android:layout_width">match_parent</item>
        <item name="android:windowMinWidthMinor">80%</item>
    </style>
    
    <style name="MyPreference" parent="@style/PreferenceThemeOverlay">
        <item name="android:tint">@color/black</item>
    </style>
</resources>